# Phi-tiny-MoE: 3.8B total, ~7.6 GB bfloat16 — fits 16 GB M3 without quantization
MODEL_ID=microsoft/Phi-tiny-MoE-instruct

# Enable quantization (int8 on MPS, int4 via bitsandbytes on CUDA)
# Not needed for Phi-tiny-MoE on 16 GB M3 — set to false to skip
LOAD_IN_4BIT=false

# Force a specific device: mps | cuda | cpu (auto-detected when unset)
# DEVICE=mps
